{
  "name": "launcherhax",
  "version": "0.1.0",
  "description": "Desktop launcher for HaxBall with configurable local macros and keybinds.",
  "main": "src/main.js",
  "author": "jaowzin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . LauncherHax --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true --ignore='^/dist$' --ignore='^/.git$'",
    "zip:win": "node scripts/zip-win.js"
  },
  "devDependencies": {
    "@electron/packager": "latest",
    "archiver": "latest",
    "electron": "latest"
  }
}
